#Find available AZs
aws ec2 describe-availability-zones --filters Name=zone-type,Values=availability-zone --region us-east-1 --query AvailabilityZones[].ZoneName

#Find available instance types
aws ec2 describe-instance-type-offerings --location-type region --filters "Name=location,Values=us-east-1" --query "InstanceTypeOfferings[].InstanceType" --output table

